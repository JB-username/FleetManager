@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <!-- Max width 500px keeps the form beautifully centered and sized on mobile & desktop -->
        <div class="col-12 col-md-6 col-lg-5" style="max-width: 500px;">
            
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h3 class="card-title fw-bold text-center mb-1 display-6">Capture Readings</h3>
                    <p class="text-muted text-center small mb-4">Please log the current status below</p>

                    <form method="post" enctype="multipart/form-data" novalidate>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Vehicle</label>
                            <input class="form-control form-control-lg" value="@Model.VehicleRegistration" readonly />
                        </div>

                        <!-- Odometer Reading -->
                        <div class="mb-3">
                            <label asp-for="Input.OdometerReading" class="form-label fw-semibold"></label>
                            <input asp-for="Input.OdometerReading" type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-lg text-end" placeholder="0" />
                            <span asp-validation-for="Input.OdometerReading" class="text-danger small"></span>
                        </div>

                        <!-- Camera / Photo Upload -->
                        <div class="mb-4">
                            <label asp-for="Input.PhotoFile" class="form-label fw-semibold"></label>
                            <input asp-for="Input.PhotoFile" type="file" accept="image/*" capture="environment" class="form-control form-control-lg" />
                            <span asp-validation-for="Input.PhotoFile" class="text-danger small"></span>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill py-3 fw-bold shadow-sm">
                                Submit
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <!-- Built-in ASP.NET client-side validation for instant mobile feedback -->
    <partial name="_ValidationScriptsPartial" />
}
