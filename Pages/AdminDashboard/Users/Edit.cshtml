@page
@model FleetManager.Pages.AdminDashboard.Users.EditModel
@{
}

<h2>Edit User</h2>

<form method="post">
    <input type="hidden" asp-for="ApplicationUser.Id" />

    <div class="mb-3">
        <label asp-for="ApplicationUser.FullName" class="form-label"></label>
        <input asp-for="ApplicationUser.FullName" class="form-control" />
        <span asp-validation-for="ApplicationUser.FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApplicationUser.Email" class="form-label"></label>
        <input asp-for="ApplicationUser.Email" class="form-control" />
        <span asp-validation-for="ApplicationUser.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">New Password (leave empty to keep current)</label>
        <div class="input-group">
            <input asp-for="Password" id="Password" type="text" class="form-control" />
            <button type="button" class="btn btn-outline-secondary" onclick="generatePassword()">Generate</button>
            <button type="button" class="btn btn-outline-secondary" onclick="copyPassword()">Copy</button>
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApplicationUser.VehicleId" class="form-label">Vehicle</label>
        <select asp-for="ApplicationUser.VehicleId" asp-items="Model.Vehicles" class="form-control"></select>
    </div>

    <div class="form-check mb-3">
        <input asp-for="ApplicationUser.IsActive" class="form-check-input" />
        <label asp-for="ApplicationUser.IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Generate a password that satisfies typical Identity settings
        function generatePassword() {
            const length = 12; // longer than minimum
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const digits = '0123456789';
            const specials = '!@@#$%^&*()_+-=[]{}|;:,.<>?';

            // ensure each required category is present
            let pwd = '';
            pwd += upper.charAt(Math.floor(Math.random() * upper.length));
            pwd += lower.charAt(Math.floor(Math.random() * lower.length));
            pwd += digits.charAt(Math.floor(Math.random() * digits.length));
            pwd += specials.charAt(Math.floor(Math.random() * specials.length));

            const all = upper + lower + digits + specials;
            for (let i = pwd.length; i < length; i++) {
                pwd += all.charAt(Math.floor(Math.random() * all.length));
            }

            // shuffle
            pwd = pwd.split('').sort(() => 0.5 - Math.random()).join('');

            document.getElementById('Password').value = pwd;
        }

        function copyPassword() {
            const el = document.getElementById('Password');
            if (!el) return;
            el.select();
            el.setSelectionRange(0, 99999);
            try {
                document.execCommand('copy');
                alert('Password copied to clipboard');
            } catch (e) {
                navigator.clipboard?.writeText(el.value).then(() => alert('Password copied to clipboard')).catch(() => alert('Copy failed'));
            }
        }
    </script>
}
