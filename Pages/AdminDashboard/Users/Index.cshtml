@page
@model FleetManager.Pages.AdminDashboard.Users.IndexModel
@{
}

<h2 class="mb-5">Users</h2>

<p class="mt-2">
    <a asp-page="Create" class="btn btn-primary">Add User</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Full Name</th>
            <th>Vehicle</th>
            <th>Role</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var user in Model.Users)
{
        <tr>
            <td>@user.Email</td>
            <td>@user.FullName</td>
            <td>@user.Vehicle?.RegistrationNumber</td>
            <td>@user.RoleName</td>
            <td>@(user.IsActive ? "Yes" : "No")</td>
            <td>
                <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-secondary">Edit</a>
                <a asp-page="EditRoles" asp-route-id="@user.Id" class="btn btn-sm btn-info">Manage Roles</a>
                <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
