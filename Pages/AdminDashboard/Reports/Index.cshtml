@page
@model FleetManager.Pages.AdminDashboard.Reports.IndexModel
@{
    ViewData["Title"] = "Odometer Reports";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1>Odometer Readings Report</h1>
            <p class="text-muted">View and export odometer readings with photos by date range</p>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Date Range Filter</h5>
        </div>
        <div class="card-body">
            <form method="post" class="row g-3">
                <div class="col-md-4">
                    <label for="fromDate" class="form-label">From Date</label>
                    <input type="date" 
                           class="form-control" 
                           id="fromDate" 
                           asp-for="FromDate" />
                </div>
                <div class="col-md-4">
                    <label for="toDate" class="form-label">To Date</label>
                    <input type="date" 
                           class="form-control" 
                           id="toDate" 
                           asp-for="ToDate" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i> Filter
                    </button>
                    <button type="submit" 
                            asp-page-handler="Clear"
                            class="btn btn-secondary">
                        <i class="bi bi-arrow-clockwise"></i> Clear Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Readings.Any())
    {
        <div class="card mb-4">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Readings (@Model.Readings.Count found)</h5>
                    <div class="btn-group" role="group">
                        <button type="submit" 
                                form="exportForm"
                                name="exportType"
                                value="WithPhotos"
                                class="btn btn-success btn-sm" 
                                title="Download Excel with embedded photos">
                            <i class="bi bi-file-earmark-spreadsheet"></i> Excel (With Photos)
                        </button>
                        <button type="submit" 
                                form="exportForm"
                                name="exportType"
                                value="NoPhotos"
                                class="btn btn-info btn-sm" 
                                title="Download Excel without photos (faster/smaller file)">
                            <i class="bi bi-file-earmark-spreadsheet"></i> Excel (No Photos)
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-striped">
                        <thead class="table-light">
                            <tr>
                                <th>Captured Date</th>
                                <th>Vehicle</th>
                                <th>User Email</th>
                                <th>User Name</th>
                                <th>Odometer (km)</th>
                                <th>Photo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reading in Model.Readings)
                            {
                                <tr>
                                    <td>
                                        @reading.CapturedAt.ToString("g", System.Globalization.CultureInfo.CurrentCulture)
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@reading.VehicleRegistration</span>
                                    </td>
                                    <td>@reading.UserEmail</td>
                                    <td>@reading.UserFullName</td>
                                    <td>
                                        <strong>@reading.KilometerReading.ToString("N0")</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(reading.ImagePath))
                                        {
                                            <a href="/Files/Serve?id=@reading.Id" 
                                               target="_blank" 
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-image"></i> View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>No readings found</strong> for the selected date range.
        </div>
    }
</div>

<form id="exportForm" method="post" asp-page-handler="Export" style="display: none;">
    <input type="hidden" asp-for="FromDate" />
    <input type="hidden" asp-for="ToDate" />
</form>

<style>
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
</style>
